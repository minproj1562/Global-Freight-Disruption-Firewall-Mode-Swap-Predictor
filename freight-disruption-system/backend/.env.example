# ==========================================
# GLOBAL FREIGHT DISRUPTION FIREWALL
# Backend Environment Configuration Template
# ==========================================

# ============= DATABASE (PostgreSQL + PostGIS) =============
# Connection string format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freight_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=freight_db

# ============= JWT SECURITY & AUTHENTICATION =============
# Strong cryptographic secret for signing JWT access tokens (minimum 32 characters)
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Development demo authentication override (MUST be "false" in production)
# When set to "true", requests without Bearer tokens fallback to local demo_user
ENABLE_DEMO_AUTH=false

# ============= REDIS (Pub/Sub & Rate Limiting) =============
# Required for fleet_updates real-time WebSocket broadcast and auth rate limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_ENABLED=true

# ============= TRANSACTIONAL EMAIL (Outbound SMTP) =============
# Optional in development; when empty, verification tokens are returned in API response
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@freightfirewall.gov
SMTP_TLS=true

# ============= EXTERNAL MARITIME & WEATHER API KEYS =============
# AISStream WebSocket Live Stream Key (https://aisstream.io/)
AISSTREAM_API_KEY=your_aisstream_api_key_here

# OpenWeather One Call / Current Weather API Key (https://openweathermap.org/)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Mapbox Access Token for geospatial map tile rendering (optional on backend)
MAPBOX_TOKEN=your_mapbox_token_here

# Port Operations Authority Integration Key (optional)
PORT_API_KEY=your_port_api_key_here

# ============= CURRENCY EXCHANGE =============
EXCHANGE_RATE_API_URL=https://api.exchangerate.host/latest
EXCHANGE_RATE_API_KEY=
DEFAULT_CURRENCY=USD
FALLBACK_USD_INR_RATE=83.25

# ============= CORS CONFIGURATION =============
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============= SERVER RUNTIME =============
HOST=0.0.0.0
PORT=8000
RELOAD=true
DEBUG=false
